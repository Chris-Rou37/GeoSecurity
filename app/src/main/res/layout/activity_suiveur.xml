<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".vue.Suiveur">

    <!-- Title at the top, centered -->
    <TextView
        android:id="@+id/titleSuiveur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Suiveur"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/titleSuiveur"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Map CardView -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/mapImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/map_background"
                        android:scaleType="centerCrop"
                        android:contentDescription="Map Background" />

                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <!-- Green Info Box -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#E8F5E9"
                app:strokeWidth="2dp"
                app:strokeColor="#22C55E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvNom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="nom : Christophe"
                        android:textSize="12sp"
                        android:textColor="#0F172A" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="6dp" />

                    <TextView
                        android:id="@+id/tvAdresse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="adresse : notre dame d'Oé"
                        android:textSize="12sp"
                        android:textColor="#0F172A" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="6dp" />

                    <TextView
                        android:id="@+id/tvDeplacement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="se déplace : oui"
                        android:textSize="12sp"
                        android:textColor="#0F172A" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="14dp" />

            <!-- "Sélectionner un utilisateur" Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectionnerUtilisateur"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Utilisateur"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                app:backgroundTint="#0F172A"
                app:cornerRadius="16dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <!-- "Mon emplacement" Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMaPosition"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Ma Position"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                app:backgroundTint="#F1F5D1"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
