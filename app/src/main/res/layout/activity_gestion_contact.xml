<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".vue.Gestion_Contact">

    <!-- Title outside the card at the top -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gestion des Contact"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Form CardView placed higher up below title -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardForm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Nom -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nom"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="4dp" />

            <EditText
                android:id="@+id/etNom"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_edit_text"
                android:hint="Nom"
                android:textColorHint="#94A3B8"
                android:textColor="#0F172A"
                android:paddingHorizontal="12dp"
                android:textSize="15sp"
                android:inputType="textPersonName"
                android:autofillHints="name" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <!-- Prénom -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prénom"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="4dp" />

            <EditText
                android:id="@+id/etPrenom"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_edit_text"
                android:hint="Prénom"
                android:textColorHint="#94A3B8"
                android:textColor="#0F172A"
                android:paddingHorizontal="12dp"
                android:textSize="15sp"
                android:inputType="textPersonName"
                android:autofillHints="name" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <!-- Num SMS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Num SMS"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="4dp" />

            <EditText
                android:id="@+id/etNumSms"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_edit_text"
                android:hint="Numéro SMS"
                android:textColorHint="#94A3B8"
                android:textColor="#0F172A"
                android:paddingHorizontal="12dp"
                android:textSize="15sp"
                android:inputType="phone"
                android:autofillHints="phone" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="14dp" />

            <!-- Button Enregistrer (Full width line) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnregistrer"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Enregistrer"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                app:backgroundTint="#0F172A"
                app:cornerRadius="10dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <!-- Button Modifier (Full width line) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModifier"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Modifier"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                app:backgroundTint="#F1F5F9"
                app:cornerRadius="10dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <!-- Button Supprimer (Full width line) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSupprimer"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Supprimer"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                app:backgroundTint="#DC2626"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Retour Button outside/below the card -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetour"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:text="Retour"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        app:backgroundTint="#F1F5F9"
        app:cornerRadius="10dp"
        app:layout_constraintTop_toBottomOf="@id/cardForm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
